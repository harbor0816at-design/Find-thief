.wrap { padding-bottom: 200rpx; }
.seg { background: #fff; border: 3rpx solid var(--ink); border-radius: 26rpx; padding: 8rpx; text-align: center; }
.seg-on { display: block; background: var(--sun); border-radius: 18rpx; padding: 14rpx 0; font-weight: 900; }

.ev-row { margin-top: 30rpx; display: flex; align-items: center; gap: 22rpx; padding: 26rpx 28rpx; }
.ev-ic { flex: none; width: 84rpx; height: 84rpx; border-radius: 24rpx; background: var(--brand); color: var(--sun); font-size: 1.4rem; display: flex; align-items: center; justify-content: center; border: 3rpx solid var(--ink); }
.ev-main { flex: 1; min-width: 0; }
.ev-t { font-weight: 900; font-size: 1.05rem; }
.ev-d { color: var(--muted); font-size: 0.75rem; }
.arrow { flex: none; width: 16rpx; height: 16rpx; border-top: 4rpx solid #B4B6C8; border-right: 4rpx solid #B4B6C8; transform: rotate(45deg); }

.stat { margin-top: 30rpx; display: flex; align-items: center; justify-content: space-between; padding: 30rpx 36rpx; }
.stat-n .n { font-size: 3rem; font-weight: 900; color: var(--brand); line-height: 1; }
.stat-n .u { font-weight: 900; color: var(--brand); margin-left: 8rpx; }
.stat-l { color: var(--muted); font-size: 0.85rem; margin-top: 8rpx; }
.stat-pin { width: 110rpx; height: 132rpx; }

.empty-card { margin-top: 30rpx; padding: 50rpx 30rpx 44rpx; text-align: center; }
.em-art { position: relative; width: 220rpx; height: 130rpx; margin: 0 auto; }
.em-bag { position: absolute; left: 0; bottom: 0; width: 170rpx; height: 100rpx; border: 4rpx solid var(--ink); border-radius: 18rpx; background: var(--brand-soft); }
.em-glass { position: absolute; right: 0; top: 0; width: 70rpx; height: 70rpx; border: 6rpx solid var(--brand); border-radius: 50%; background: rgba(255, 255, 255, 0.7); }
.em-title { font-size: 1.15rem; font-weight: 900; margin: 30rpx 0 28rpx; }
.em-btn { width: 340rpx; margin: 0 auto; }

.like-wrap { margin-top: 56rpx; text-align: center; }
.like { display: inline-flex; align-items: center; gap: 16rpx; background: var(--admin); color: #fff; font-weight: 900; font-size: 1.15rem; padding: 26rpx 70rpx; border-radius: 28rpx; border: 3rpx solid var(--ink); box-shadow: 0 8rpx 0 var(--ink); }
.like.on { background: #fff; color: var(--admin); }
.like-ic { font-size: 1.3rem; }
.like-n { color: var(--muted); margin-top: 18rpx; font-size: 0.95rem; }

.menu { margin-top: 50rpx; padding: 0 30rpx; }
.mi { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 30rpx 0; border-bottom: 2rpx solid var(--line); font-weight: 800; font-size: 0.95rem; }
.mi:last-child { border-bottom: none; }
.mi-v { color: var(--muted); font-weight: 600; font-size: 0.82rem; flex: none; }
.mi-v.red { color: var(--admin); font-weight: 900; }
.ver { text-align: center; color: #C3C5D4; font-size: 0.72rem; margin-top: 40rpx; }

.share { position: fixed; right: 30rpx; bottom: calc(30rpx + env(safe-area-inset-bottom)); margin: 0; background: #fff; border: 3rpx solid var(--ink); box-shadow: 0 6rpx 0 var(--ink); border-radius: 999rpx; font-weight: 900; font-size: 0.95rem; padding: 0 36rpx; line-height: 84rpx; }
.share::after { border: none; }
.fs-opts { display: flex; gap: 20rpx; margin-top: 24rpx; }
.fs { flex: 1; height: 120rpx; border-radius: 28rpx; border: 3rpx solid var(--line); display: flex; align-items: center; justify-content: center; font-weight: 900; }
.fs.on { border-color: var(--ink); background: var(--sun); box-shadow: 0 6rpx 0 var(--ink); }
