<page-meta root-font-size="{{rootFs}}"></page-meta>
<view class="wrap" style="padding-top:{{navTop}}px">
  <view class="page-hd"><text class="page-title">地点申诉</text></view>

  <view class="sbox card">
    <view class="s-in">
      <text class="s-ic">⌕</text>
      <input class="s-kw" value="{{kw}}" placeholder="搜索地点名称" placeholder-class="ph" confirm-type="search" bindinput="onKw" bindconfirm="load" />
    </view>
    <view class="s-btn" hover-class="btn-hover" bindtap="load">搜索</view>
  </view>

  <view class="cta" hover-class="btn-hover" bindtap="newAppeal">
    <view>
      <view class="cta-t">我是被标记的商家 / 场所</view>
      <view class="cta-d">认为标记有误、已过时或已整改，点这里申请复核</view>
    </view>
    <text class="cta-a">发起申诉</text>
  </view>

  <view class="sub-title">申诉公示</view>
  <view wx:if="{{loading}}" class="loading">正在读取…</view>
  <view wx:elif="{{!items.length}}" class="empty soft"><view class="em-title">{{kw ? '没有找到相关申诉' : '还没有申诉记录'}}</view><view>被标记的场所提交申诉后，处理结果会在这里公示。</view></view>
  <view wx:for="{{items}}" wx:key="id" class="ap {{item.status === 'pending' ? 'pending' : ''}}" data-id="{{item.placeId}}" bindtap="openPlace">
    <view class="ap-hd">
      <view class="ap-name">{{item.placeName}}</view>
      <text class="badge {{item.cls}}">{{item.short}}</text>
    </view>
    <view class="ap-city">{{item.city}}</view>
    <view class="ap-dec">{{item.decision}}</view>
    <view class="ap-time">提交时间：{{item.time}}</view>
    <view wx:if="{{item.tags.length}}" class="ap-tags">
      <view class="ap-tl">管理员确认信息</view>
      <view class="chips"><text wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this" class="tag">{{t}}</text></view>
    </view>
  </view>
</view>
