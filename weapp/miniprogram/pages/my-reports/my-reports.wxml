<page-meta root-font-size="{{rootFs}}"></page-meta>
<view class="wrap">
  <view class="intro">这里的内容只有你和管理员能看到。审核通过后，管理员会把经过改写成不含个人信息的文字公开在地图上。</view>
  <view wx:if="{{loading}}" class="loading">正在读取…</view>
  <view wx:elif="{{!items.length}}" class="empty"><view class="em-title">还没有提交过证据</view><view class="btn btn-sun" style="width:340rpx;margin:0 auto" bindtap="toHome">去地图上报</view></view>
  <view wx:for="{{items}}" wx:key="id" class="rp card">
    <view class="rp-hd"><view class="rp-name">{{item.placeName}}</view><text class="badge {{item.cls}}">{{item.label}}</text></view>
    <view class="rp-meta">{{item.city}} · {{item.type}} · {{item.item}} · {{item.date}}</view>
    <view class="rp-detail">{{item.detail}}</view>
    <view wx:if="{{item.images.length}}" class="rp-imgs"><image wx:for="{{item.images}}" wx:for-item="f" wx:key="*this" src="{{f}}" mode="aspectFill" data-src="{{f}}" data-all="{{item.images}}" bindtap="preview"></image></view>
    <view wx:if="{{item.rejectReason}}" class="rp-why">未通过原因：{{item.rejectReason}}</view>
    <view class="rp-foot"><text>提交于 {{item.time}}</text><text wx:if="{{item.placeId && item.status === 'approved'}}" class="link" data-id="{{item.placeId}}" bindtap="open">查看地点 ›</text></view>
  </view>
</view>
